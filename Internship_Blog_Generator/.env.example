# Copy this file to .env and fill in your keys.
# One or more Gemini keys - the app rotates to the next key when a quota is exhausted.
GEMINI_API_KEY_1=your-first-key
GEMINI_API_KEY_2=your-second-key-optional

# Model used for planning / writing / SEO (change if your key uses another model)
GEMINI_MODEL=gemini-3.6-flash

# Optional overrides
# BLOG_REGION=Goa
# BLOG_COUNTRY=India
# BLOG_OUTPUT_DIR=output
# LLM_MODE=offline        # force offline draft mode
